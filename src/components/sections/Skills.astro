---
import Section from "../Section.astro";
import cv from "@cv";

interface Skill {
	name: string;
	level?: string;
	keywords?: string[];
}

// Skill groups come from cv.json; an empty list hides the section.
const skills = (cv.skills as Skill[]).filter(({ name }) => name?.trim());
---

{
	skills.length > 0 && (
		<Section className={Astro.props.className} title="Skills">
			<ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2 print:grid-cols-2 print:gap-x-6 print:gap-y-1">
				{skills.map(({ name, keywords = [] }) => (
					<li class="flex flex-col gap-2 print:block print:break-inside-avoid print:text-xs">
						<h4 class="text-sm font-medium print:inline print:text-xs print:font-semibold">
							{name}
							<span class="hidden print:inline">:&nbsp;</span>
						</h4>
						{keywords.length > 0 && (
							<>
								<ul class="flex flex-wrap gap-1.5 print:hidden" aria-label={`${name} skills`}>
									{keywords.map((keyword) => (
										<li class="rounded-md border border-solid border-skin-hue/20 bg-skin-button-accent/20 px-2 py-0.5 text-xs text-skin-hue">{keyword}</li>
									))}
								</ul>
								<span class="hidden text-skin-muted print:inline">{keywords.join(", ")}</span>
							</>
						)}
					</li>
				))}
			</ul>
		</Section>
	)
}
